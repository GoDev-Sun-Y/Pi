# Pi-Work-Mode 环境变量模板
# 复制为 settings.env 并填入真实值:  Copy-Item config\settings.env.example config\settings.env
# 设置方式（改完必须新开终端窗口才生效）:
#   [System.Environment]::SetEnvironmentVariable("ZAI_API_KEY", "你的key", "User")
#
# 验证是否生效:  $env:ZAI_API_KEY      （能打印出钥匙即生效）

# ============ Agnes 大模型 API ============
# 国际站申请: https://agnes-ai.com   → 用 AGNES_API_KEY
# 国内站申请: https://agnes-ai.cn    → 用 AGNES_CN_API_KEY
# ⚠️ 钥匙必须与注册站点对齐，错配会报 401 无效的令牌
AGNES_API_KEY=
AGNES_CN_API_KEY=

# ============ 其他服务商 (可选) ============
# 智谱 GLM（国内推荐，Pi 内置 zai provider）: https://open.bigmodel.cn
# 完整 key 只在创建弹窗显示一次，漏了就删掉重建
ZAI_API_KEY=

# ============ 本地服务 ============
# Ollama (全部免费, 默认本地运行, 无需配置)
OLLAMA_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333
