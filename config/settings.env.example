# Pi-Work-Mode 环境变量模板
# 复制为 settings.env 并填入真实值:  Copy-Item config\settings.env.example config\settings.env
# 然后设置系统环境变量 (以 AGNES_API_KEY 为例):
#   [System.Environment]::SetEnvironmentVariable("AGNES_API_KEY", "sk-xxx", "User")

# ============ Agnes 大模型 API ============
# Sapiens AI 控制台申请: https://api.sapiens.ai  (免费额度)
AGNES_API_KEY=

# 可选: 自定义 API 端点 (默认走官方)
# AGNES_API_BASE=https://api.sapiens.ai/v1

# ============ 其他服务商 (可选) ============
# Zai (glm 系列): https://www.zhipuai.com/
ZAI_API_KEY=

# ============ 本地服务 ============
# Ollama (全部免费, 默认本地运行, 无需配置)
OLLAMA_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333
